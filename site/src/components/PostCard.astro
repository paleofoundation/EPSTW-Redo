---
/*
 * PostCard — publication-style post card.
 *
 * Substack pattern: horizontal layout, text on the left, square thumbnail
 * on the right (on desktop). Stacks on mobile. Top and bottom hairline
 * borders let a vertical stack of cards read as a continuous list.
 *
 * Thumbnail is optional; if omitted, a bone-colored placeholder with a
 * small-caps kicker glyph renders in its place (keeps the grid aligned).
 */
interface Props {
  href: string;
  title: string;
  excerpt?: string;
  kicker?: string;      // category / section label (e.g. "Field note", "Proposal")
  author?: string;
  date?: string;
  readingTime?: string; // e.g. "8 min read"
  thumbnail?: string;   // URL to thumbnail image, or omit for placeholder
  thumbnailGlyph?: string; // letter/symbol to show in placeholder
  featured?: boolean;   // larger layout for hero/lead posts
}

const {
  href,
  title,
  excerpt,
  kicker,
  author,
  date,
  readingTime,
  thumbnail,
  thumbnailGlyph,
  featured = false,
} = Astro.props;
---

<article class={`border-b border-ink/10 py-8 ${featured ? 'md:py-12' : ''}`}>
  <a href={href} class="group block">
    <div class={`flex flex-col-reverse md:flex-row gap-6 md:gap-10 ${featured ? 'md:gap-12' : ''}`}>

      <!-- Text column -->
      <div class="flex-1 min-w-0">
        {kicker && (
          <div class="small-caps text-xs text-flame mb-2">{kicker}</div>
        )}
        <h3 class={
          featured
            ? "font-display text-3xl md:text-4xl lg:text-5xl tracking-tight leading-[1.1] text-ink group-hover:text-flame transition-colors mb-3"
            : "font-display text-xl md:text-2xl tracking-tight leading-tight text-ink group-hover:text-flame transition-colors mb-2"
        }>
          <span set:html={title}></span>
        </h3>
        {excerpt && (
          <p class={
            featured
              ? "font-serif text-base md:text-lg text-ink/70 leading-relaxed mb-4 line-clamp-3"
              : "font-serif text-ink/70 leading-relaxed mb-3 line-clamp-2"
          }>
            {excerpt}
          </p>
        )}
        <div class="flex flex-wrap items-center gap-2 text-xs text-ink/50 font-body">
          {author && <span class="font-medium text-ink/70">{author}</span>}
          {author && (date || readingTime) && <span aria-hidden="true">·</span>}
          {date && <time>{date}</time>}
          {date && readingTime && <span aria-hidden="true">·</span>}
          {readingTime && <span>{readingTime}</span>}
        </div>
      </div>

      <!-- Thumbnail column -->
      <div class={
        featured
          ? "w-full md:w-64 lg:w-80 shrink-0"
          : "w-full md:w-40 lg:w-48 shrink-0"
      }>
        <div class={`aspect-square bg-bone border border-ink/10 relative overflow-hidden ${featured ? 'md:aspect-[4/3]' : ''}`}>
          {thumbnail ? (
            <img src={thumbnail} alt="" class="absolute inset-0 w-full h-full object-cover" />
          ) : (
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="font-display text-4xl md:text-5xl text-ink/20">
                {thumbnailGlyph || (title?.charAt(0) ?? '')}
              </div>
            </div>
          )}
        </div>
      </div>

    </div>
  </a>
</article>

<style>
  /* line-clamp utilities fallback (Tailwind 3 already includes these under
     @tailwindcss/line-clamp in 3.3+, but keep a safe fallback here). */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
