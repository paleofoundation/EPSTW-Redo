---
const links = [
  { href: '/the-book', label: 'The Book' },
  { href: '/near-time', label: 'Near Time' },
  { href: '/fourth-axis', label: 'The Fourth Axis' },
  { href: '/one-hundred-camels', label: 'One Hundred Camels' },
  { href: '/field-notes', label: 'Field Notes' },
  { href: '/about', label: 'About' },
];
---

<header class="border-b border-ink/10 relative">
  <div class="mx-auto max-w-6xl px-6 py-6 flex items-center justify-between gap-8">

    <a href="/" class="font-display text-xl tracking-tight hover:text-ochre transition-colors">
      The Sustainability Diet
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:block" aria-label="Primary">
      <ul class="flex gap-6 text-sm">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="text-ink/70 hover:text-ink transition-colors"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile nav: <details>-based, no JavaScript required. -->
    <details class="md:hidden relative group">
      <summary
        class="list-none cursor-pointer p-2 -mr-2 text-ink/80 hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-ochre"
        aria-label="Open menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" class="group-open:hidden">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" class="hidden group-open:block">
          <line x1="5" y1="5" x2="19" y2="19" />
          <line x1="19" y1="5" x2="5" y2="19" />
        </svg>
      </summary>
      <nav
        aria-label="Primary (mobile)"
        class="absolute right-0 top-full mt-2 w-64 bg-paper border border-ink/15 shadow-lg z-40"
      >
        <ul class="py-2">
          {links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="block px-5 py-3 text-sm text-ink/80 hover:bg-bone/40 hover:text-ink transition-colors border-b border-ink/5 last:border-b-0"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>

  </div>
</header>

<style>
  /* Hide the default disclosure triangle. */
  summary::-webkit-details-marker { display: none; }
  summary { list-style: none; }
</style>
