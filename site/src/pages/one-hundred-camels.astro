---
import Base from '../layouts/Base.astro';

const families = [
  {
    kind: 'The experiment',
    items: [
      {
        href: '/one-hundred-camels/the-experiment',
        title: 'One hundred camels, an osage orange orchard.',
        body: 'The proposal the book is asking someone to let us run. Framed as a land flip: a distressed parcel acquired at distressed basis, a five-year MVP gate, a ten-year flip window, and four pre-defined exits. Sixteen sections, a falsification list at two gates, a phased budget, an open letter, and a contact form.',
        cta: 'Read the proposal',
        emphasis: true,
      }
    ]
  },
  {
    kind: 'Think alongside',
    blurb: 'Two pages meant to be read before anyone signs on. The first is the critics\u2019 best case against the project, in their own voices. The second is the list of ways a reader can actually help.',
    items: [
      {
        href: '/one-hundred-camels/critics',
        title: 'Critics and counter-positions',
        body: 'Caro (2007), Rubenstein et al. (2006), and Oliveira-Santos & Fernandez (2010) on why Pleistocene rewilding might be a mistake. Each argument stated in the critic\u2019s voice, followed by a considered response.',
        cta: 'Read the critics',
      },
      {
        href: '/one-hundred-camels/contribute',
        title: 'Contribute',
        body: 'Ten concrete categories of help the project needs — landowners, veterinary specialists, archaeologists, camelid practitioners, foundations, legal counsel, volunteers, scientific advisors, and readers who will just pass the proposal along.',
        cta: 'See how to contribute',
      },
    ]
  },
  {
    kind: 'Adjacent projects',
    blurb: 'Other large-landscape restoration and proxy-megafaunal projects. Each named with its theory of change and a single honest link back.',
    items: [
      {
        title: 'American Prairie',
        body: 'Assembling a three-million-acre grassland reserve on the northern Great Plains, with bison as the keystone grazer. Theory of change: land aggregation plus ungulate-driven grassland restoration at continental scale.',
        external: 'https://www.americanprairie.org',
        externalLabel: 'americanprairie.org',
      },
      {
        title: 'Pleistocene Park',
        body: 'Sergey and Nikita Zimov\u2019s long-running mammoth-steppe project in northeast Siberia. Large herbivores used as a tool to stabilize permafrost via grazing-mediated albedo and soil-temperature change.',
        external: 'https://pleistocenepark.ru',
        externalLabel: 'pleistocenepark.ru',
      },
      {
        title: 'Armendaris Ranch and the Bolson tortoise',
        body: 'Ted Turner\u2019s Chihuahuan Desert ranch; home to the first North American return of a Pleistocene survivor (the Bolson tortoise) to its ecological range, and to ongoing experimental work on desert grassland recovery under large-ungulate management.',
        external: 'https://tedturnerreserves.com/armendaris-ranch',
        externalLabel: 'tedturnerreserves.com',
      },
      {
        title: 'Oostvaardersplassen and Knepp',
        body: 'Two European rewilding experiments using cattle and horse lineages as proxies for aurochs and tarpan. Oostvaardersplassen\u2019s winter mortality controversy and Knepp\u2019s celebrated regeneration mark the welfare-threshold question for every project in this family.',
        external: 'https://knepp.co.uk',
        externalLabel: 'knepp.co.uk',
      },
      {
        title: 'The Siberian mammoth-ivory debate',
        body: 'Not a restoration project but a standing question: how does a rewilding ethic approach a commodity (fossil ivory) whose existence is an incentive against exactly the kind of site stewardship the ethic would ask for?',
      },
    ]
  },
];
---

<Base title="One Hundred Camels — The Sustainability Diet" description="The book's index of rewilding work: the experiment, adjacent projects, and the critics' arguments. Each treated on its own terms.">
  <section class="mx-auto max-w-6xl px-6 pt-24 pb-40">

    <header class="mb-20 max-w-reading">
      <p class="small-caps text-xs text-ochre mb-4">One Hundred Camels</p>
      <h1 class="font-display text-5xl md:text-6xl tracking-tight leading-[1.05] mb-8">
        The experiment, and the family of work it belongs to.
      </h1>
      <p class="font-serif text-lg md:text-xl leading-relaxed text-ink/75">
        One Hundred Camels is the book's index of large-landscape
        restoration: the specific experiment the book is asking
        someone to run, the adjacent projects that frame it, and
        the critics whose arguments the book takes seriously. Every
        entry here is sorted for whether it helps a reader decide
        what they think of the proposal.
      </p>
    </header>

    {families.map(family => (
      <section class="mb-24">
        <div class="flex items-baseline gap-6 mb-3">
          <h2 class="small-caps text-xs text-ochre">{family.kind}</h2>
        </div>
        {family.blurb && (
          <p class="font-serif text-ink/70 leading-relaxed max-w-reading mb-10">
            {family.blurb}
          </p>
        )}

        <div class="grid md:grid-cols-2 gap-6">
          {family.items.map(item => (
            <article class={
              item.emphasis
                ? "border-2 border-ink p-8 bg-bone/40 md:col-span-2"
                : "border border-ink/15 p-6 bg-bone/20"
            }>
              <h3 class={
                item.emphasis
                  ? "font-display text-3xl md:text-4xl tracking-tight leading-tight mb-5"
                  : "font-display text-xl tracking-tight leading-tight mb-4"
              }>
                {item.href ? (
                  <a href={item.href} class="hover:text-ochre transition-colors">
                    <span set:html={item.title}></span>
                  </a>
                ) : (
                  <span set:html={item.title}></span>
                )}
              </h3>
              <p class={
                item.emphasis
                  ? "font-serif text-base md:text-lg text-ink/80 leading-relaxed mb-6"
                  : "text-ink/75 leading-relaxed text-[0.975rem] mb-4"
              }>
                {item.body}
              </p>
              {item.href && (
                <a href={item.href} class="inline-flex items-center gap-2 px-5 py-2.5 bg-ink text-paper hover:bg-ochre transition-colors text-sm small-caps">
                  {item.cta || 'Read more'}
                </a>
              )}
              {item.external && (
                <a href={item.external} rel="noopener noreferrer" target="_blank"
                   class="inline-flex items-center gap-2 text-sm text-ochre hover:underline">
                  {item.externalLabel || item.external} &#8599;
                </a>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}

    <hr class="hairline my-16" />

    <section class="max-w-reading font-serif text-ink/70 leading-relaxed">
      <p>
        Each adjacent project here is described from publicly available
        project statements and published literature. The framings of
        &ldquo;theory of change&rdquo; and &ldquo;what this project
        borrows / changes&rdquo; are the author's editorial readings,
        not the projects'. Where a project has a formal response
        page to critics, those responses are linked from its external
        link rather than summarized here.
      </p>
      <p class="mt-4">
        For the terms used on this page, see
        <a href="/near-time/glossary" class="text-ochre hover:underline">the glossary</a>.
        For data sources used in the atlas more generally, see
        <a href="/near-time/sources" class="text-ochre hover:underline">sources &amp; methodology</a>.
      </p>
    </section>

  </section>
</Base>
